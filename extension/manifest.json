{
  "manifest_version": 3,
  "name": "AMA 工作区",
  "version": "0.3.0",
  "description": "工作区、拖放分屏与键盘命令面板：管理链接、搜索标签、归档与恢复。工作区数据保存在本地。",
  "minimum_chrome_version": "121",
  "permissions": ["storage", "tabs", "tabGroups", "sidePanel", "alarms", "contextMenus", "search", "favicon"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "打开 AMA 工作区" },
  "options_ui": { "page": "panel.html?view=settings", "open_in_tab": true },
  "commands": {
    "open-palette": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
      "description": "打开 AMA 命令面板"
    },
    "open-workspace": {
      "suggested_key": { "default": "Alt+Shift+K", "mac": "Alt+Shift+K" },
      "description": "打开 AMA 工作区与搜索"
    }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
