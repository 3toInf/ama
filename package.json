{
  "name": "ama-browser-workspace",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Local-first Chrome workspace extension inspired by Arc",
  "engines": { "node": ">=22.8" },
  "scripts": {
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:native": "node scripts/native-smoke.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "package": "python3 scripts/package.py"
  }
}
